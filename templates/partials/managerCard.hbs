{{#if create}}
<article class="weapon-skills-card weapon-skills-card--create">
    <button type="button" class="weapon-skills-card__open" data-action="{{action}}">
        <span class="weapon-skills-card__art weapon-skills-card__art--create">
            <span class="weapon-skills-card__plus"><i class="fas fa-plus" aria-hidden="true"></i></span>
        </span>
        <span class="weapon-skills-card__name">{{localize label}}</span>
    </button>
</article>
{{else}}
<article class="weapon-skills-card">
    <button type="button" class="weapon-skills-card__open" data-action="{{action}}" data-card-id="{{entry.id}}" title="{{entry.name}}">
        <span class="weapon-skills-card__art">
            <img class="weapon-skills-card__image" src="{{entry.img}}" alt="">
        </span>
        <span class="weapon-skills-card__name">{{entry.name}}</span>
    </button>
    <button type="button" class="weapon-skills-card__remove" data-action="{{removeAction}}" data-card-id="{{entry.id}}"
        aria-label="{{localize 'WTTRPGEnhancements.Cards.Remove' name=entry.name}}">
        <i class="fas fa-times" aria-hidden="true"></i>
    </button>
</article>
{{/if}}
